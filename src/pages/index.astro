---
import SwipeView from "../components/SwipeView";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    style="display: flex; flex-direction: column; gap: 1em; align-items: center; height: 100dvh; justify-content: center;"
  >
    <SwipeView client:load />
    <a
      href="/expert-mode"
      style="border: 1px black solid; padding: .5em; border-radius: .5em; text-decoration: none;"
      >Filter Mode</a
    >
  </div>
</Layout>
