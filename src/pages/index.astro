---
import SwipeView from "../components/SwipeView";
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/base";
---

<Layout>
  <div
    style="background-color: #edece9; display: flex; flex-direction: column; gap: 1em; align-items: center; min-height: 100dvh; justify-content: flex-start; padding-top: 0.5rem;"
  >
    <SwipeView client:load />
    <a
      href={withBase("expert-mode")}
      style="border: 1px black solid; padding: .5em; border-radius: .5em; text-decoration: none;"
      >Filter Mode</a
    >
  </div>
</Layout>
